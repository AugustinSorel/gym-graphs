package exercises

import (
	"fmt"

	"github.com/augustinsorel/gym-graphs/internal/service"
	"github.com/augustinsorel/gym-graphs/web/ui/link"
)

templ noExercisesMessage() {
	<section class="mt-40 gap-5 flex flex-col items-center text-center">
		<span
			aria-hidden="true"
			class="bg-surface-container rounded-md size-12 flex items-center justify-center text-2xl text-outline"
		>
			0
		</span>
		<h1 class="uppercase font-semibold">no exercises yet</h1>
		<p class="text-balance text-outline text-sm max-w-sm">
			Add your first movement and start building your training logs
		</p>
		@link.Link(link.Props{Href: "/exercises/new"}) {
			+ add exercise
		}
	</section>
}

templ ExerciseRows(page service.ExercisesPage) {
	for _, exercise := range page.Rows {
		<tr class="border-b-2 border-dotted border-outline/50">
			<td class="py-4">{ exercise.Name }</td>
			if exercise.SetsCount == 0 {
				<td class="py-4 text-outline">-</td>
			} else {
				<td class="py-4">{ fmt.Sprintf("%d", exercise.SetsCount) }</td>
			}
		</tr>
	}
	if page.HasNextPage {
		<tr
			hx-get={ fmt.Sprintf("/exercises?cursor=%d", page.NextCursor) }
			hx-swap="outerHTML"
			hx-trigger="revealed"
			class="text-outline text-sm"
		>
			<td class="py-4">loading...</td>
			<td></td>
		</tr>
	}
}

templ exercisesList(page service.ExercisesPage, totalCount int64) {
	<header class="flex items-center justify-between">
		<span class="text-outline uppercase text-sm">
			exercises ({ fmt.Sprintf("%d", totalCount) })
		</span>
		@link.Link(link.Props{Href: "/exercises/new"}) {
			+ add
		}
	</header>
	<table class="w-full text-sm border-collapse">
		<thead>
			<tr class="border-b-2">
				<th class="text-left font-semibold py-2 text-outline uppercase text-xs">name</th>
				<th class="text-left font-semibold py-2 text-outline uppercase text-xs">sets</th>
			</tr>
		</thead>
		<tbody>
			@ExerciseRows(page)
		</tbody>
	</table>
}

templ ExercisesPage(page service.ExercisesPage) {
	<main class="flex flex-col py-10 px-5 lg:px-10 gap-5 max-w-3xl mx-auto my-10 lg:my-20">
		if page.TotalCount == 0 {
			@noExercisesMessage()
		} else {
			@exercisesList(page, page.TotalCount)
		}
	</main>
}
