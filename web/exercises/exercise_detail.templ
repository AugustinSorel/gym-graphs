package exercises

import (
	"fmt"
	"github.com/augustinsorel/gym-graphs/internal/database/db"
	"github.com/augustinsorel/gym-graphs/internal/weightunit"
	"github.com/augustinsorel/gym-graphs/web/ui/link"
)

type ExerciseDetailData struct {
	ID         int32
	Name       string
	Best1RMInG float64
	WeightUnit db.WeightUnit
}

templ ExerciseDetailPage(ex ExerciseDetailData) {
	<main class="flex flex-col py-10 px-5 lg:px-10 gap-10 lg:gap-20 max-w-3xl mx-auto my-10 lg:my-20">
		@exerciseDetailHeader(ex)
		@exerciseFunFacts(ex)
		@exerciseManage(ex)
	</main>
}

templ exerciseDetailHeader(ex ExerciseDetailData) {
	<header class="grid grid-cols-[1fr_auto] gap-y-10 lg:gap-y-5">
		<h1 class="text-3xl font-semibold capitalize col-span-2">
			{ ex.Name }
		</h1>
		<span class="uppercase text-outline text-sm">
			sets (-)
		</span>
		@link.Link(link.Props{
			Href: fmt.Sprintf("/exercises/%d/sets/new", ex.ID),
		}) {
			+ add
		}
	</header>
}

templ exerciseManage(ex ExerciseDetailData) {
	<section>
		<h2 class="uppercase text-outline border-b-4 border-on-surface text-sm pb-2 w-full">
			manage
		</h2>
		<div class="grid grid-cols-[1fr_auto] py-7 border-b-2 border-outline/50 border-dotted gap-3">
			<dl class="space-y-1">
				<dt class="text-outline text-sm">name</dt>
				<dd class="capitalize break-all text-balance">{ ex.Name }</dd>
			</dl>
			@link.Link(link.Props{
				Href:  fmt.Sprintf("/exercises/%d/name", ex.ID),
				Class: "my-auto text-sm",
			}) {
				rename
			}
		</div>
		<div class="py-7 border-b-2 border-outline/50 border-dotted grid grid-cols-[1fr_auto] gap-y-3 items-center">
			<div class="space-y-1">
				<p class="text-outline text-sm">remove exercise</p>
				<p class="text-balance">permanently delete this exercise and all its sets.</p>
			</div>
			@link.Link(link.Props{
				Href:  fmt.Sprintf("/exercises/%d/remove", ex.ID),
				Class: "my-auto ml-auto text-sm font-semibold text-error underline hover:opacity-70 transition-opacity hover:text-error/80",
			}) {
				delete
			}
		</div>
	</section>
}

templ exerciseFunFacts(ex ExerciseDetailData) {
	<section>
		<h2 class="uppercase text-outline border-b-4 border-on-surface text-sm pb-2 w-full">
			facts
		</h2>
		<dl class="py-7 border-b-2 border-dotted border-outline/50 grid grid-cols-2 lg:grid-cols-4 gap-2">
			<div class="grid gap-1">
				<dt class="text-outline text-xs">
					best 1<abbr title="repetition maximum" class="no-underline">rm</abbr>
				</dt>
				<dd class="text-xl font-semibold">
					if ex.Best1RMInG > 0 {
						{ fmt.Sprintf("%.1f", weightunit.Convert(ex.Best1RMInG, ex.WeightUnit)) }
						<span class="text-sm font-normal text-outline">{ weightunit.Label(ex.WeightUnit) }</span>
					} else {
						-
					}
				</dd>
			</div>
			<div class="grid gap-1">
				<dt class="text-outline text-xs">highest weight</dt>
				<dd class="text-xl font-semibold">-</dd>
			</div>
			<div class="grid gap-1">
				<dt class="text-outline text-xs">total volume</dt>
				<dd class="text-xl font-semibold">-</dd>
			</div>
			<div class="grid gap-1">
				<dt class="text-outline text-xs">total sets</dt>
				<dd class="text-xl font-semibold">-</dd>
			</div>
		</dl>
	</section>
}
