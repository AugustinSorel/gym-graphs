package exercises

import (
	"fmt"
	"github.com/augustinsorel/gym-graphs/internal/database/db"
	"github.com/augustinsorel/gym-graphs/internal/weightunit"
	"github.com/augustinsorel/gym-graphs/web/ui/alert"
	"github.com/augustinsorel/gym-graphs/web/ui/button"
	"github.com/augustinsorel/gym-graphs/web/ui/input"
	"github.com/augustinsorel/gym-graphs/web/ui/link"
	"github.com/augustinsorel/gym-graphs/web/ui/spinner"
)

type NewSetRowValues struct {
	Weight      string
	Repetitions string
}

type NewSetRowErr struct {
	Weight      string
	Repetitions string
}

type NewSetFormValues struct {
	Weight      string
	Repetitions string
}

type NewSetFormErr struct {
	Weight      string
	Repetitions string
	Root        string
}

templ NewSetPage() {
	<main class="flex flex-col py-10 px-5 lg:px-10 gap-10 lg:gap-20 max-w-3xl mx-auto my-10 lg:my-20">
		<h1 class="font-semibold text-3xl">new sets</h1>
		{ children... }
	</main>
}

templ NewSetPageWithForm(exerciseID int32, form NewSetFormValues, formErr NewSetFormErr, weightUnit db.WeightUnit) {
	@NewSetPage() {
		@NewSetForm(exerciseID, form, formErr, weightUnit)
	}
}

templ NewSetRow(row NewSetRowValues, rowErr NewSetRowErr, weightUnit db.WeightUnit) {
	{{ weightPlaceholder := "80" }}
	if weightUnit == db.WeightUnitLbs {
		{{ weightPlaceholder = "176" }}
	}
	<tr
		class="bg-[radial-gradient(circle,color-mix(in_srgb,var(--outline)_50%,transparent)_30%,transparent_40%)] bg-bottom bg-[size:4px_2px] bg-repeat-x"
	>
		<td
			class="pl-0 p-4 align-middle has-[>[aria-invalid=true]]:text-error"
		>
			<input
				step="any"
				type="number"
				name="weight"
				if row.Weight != "" {
					value={ row.Weight }
				}
				autocomplete="off"
				autofocus
				placeholder={ weightPlaceholder }
				class="w-full text-lg py-1 px-2"
				if rowErr.Weight != "" {
					aria-invalid="true"
				}
			/>
			if rowErr.Weight != "" {
				<p role="alert" class="text-error text-sm mt-1">{ rowErr.Weight }</p>
			}
		</td>
		<td
			class="p-4 align-middle has-[>[aria-invalid=true]]:text-error"
		>
			<input
				type="number"
				name="repetitions"
				if row.Repetitions != "" {
					value={ row.Repetitions }
				}
				autocomplete="off"
				placeholder="10"
				class="w-full text-lg py-1 px-2"
				if rowErr.Repetitions != "" {
					aria-invalid="true"
				}
			/>
			if rowErr.Repetitions != "" {
				<p role="alert" class="text-error text-sm mt-1">{ rowErr.Repetitions }</p>
			}
		</td>
		<td class="pr-0 p-4 align-middle w-0">
			@button.Button(button.Props{Variant: button.VariantLink, Type: button.TypeButton, Attributes: templ.Attributes{"hx-on:click": "this.closest('tr').remove()"}}) {
				remove
			}
		</td>
	</tr>
}

templ emptyNewSetRow(weightUnit db.WeightUnit) {
	@NewSetRow(NewSetRowValues{}, NewSetRowErr{}, weightUnit)
}

templ NewSetForm(exerciseID int32, form NewSetFormValues, formErr NewSetFormErr, weightUnit db.WeightUnit) {
	{{ weightPlaceholder := "80" }}
	if weightUnit == db.WeightUnitLbs {
		{{ weightPlaceholder = "176" }}
	}
	<form
		hx-post={ fmt.Sprintf("/exercises/%d/sets/new", exerciseID) }
		hx-disable="find button[type='submit']"
		hx-indicator="find button[type='submit']"
		hx-swap="outerHTML"
		class="flex flex-col gap-10"
	>
		<fieldset class="space-y-10">
			<legend class="uppercase text-outline border-b-4 border-on-surface text-sm pb-2 w-full">set 1</legend>
			<label class="grid gap-2 has-[>[aria-invalid=true]]:text-error">
				<span class="text-outline text-sm pb-2">
					weight (<abbr title={ weightunit.Name(weightUnit) } class="no-underline">{ weightunit.Abbr(weightUnit) }</abbr>):
				</span>
				<div class="border-y-2 border-dotted border-outline flex items-center">
					@input.Input(input.Props{
						Type:         input.TypeNumber,
						Name:         "weight",
						Autocomplete: "off",
						Placeholder:  weightPlaceholder,
						Value:        form.Weight,
						HasError:     formErr.Weight != "",
						Class:        "border-none flex-1 p-2",
						Attributes:   templ.Attributes{"step": "any", "autofocus": ""},
					})
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Type:    button.TypeButton,
						Class:   "border-l-2 border-outline border-dotted",
						Attributes: templ.Attributes{
							"aria-label": "increase weight by 1",
							"hx-on:click": `
								const inp = this.previousElementSibling;
								const v = parseFloat(inp.value) || 0;
								inp.value = Math.max(0, parseFloat((v - 1).toFixed(3)));
							`,
						},
					}) {
						-
					}
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Type:    button.TypeButton,
						Class:   "border-l-2 border-outline border-dotted",
						Attributes: templ.Attributes{
							"aria-label": "decrease weight by 1",
							"hx-on:click": `
								const inp = this.previousElementSibling.previousElementSibling;
								const v = parseFloat(inp.value) || 0;
								inp.value = parseFloat((v + 1).toFixed(3));
							`,
						},
					}) {
						+
					}
				</div>
				if formErr.Weight != "" {
					<p role="alert" class="text-error text-sm">{ formErr.Weight }</p>
				}
			</label>
			<label class="grid gap-2 has-[>[aria-invalid=true]]:text-error">
				<span class="text-outline text-sm pb-2">repetitions:</span>
				<div class="border-y-2 border-dotted border-outline flex items-center">
					@input.Input(input.Props{
						Type:         input.TypeNumber,
						Name:         "repetitions",
						Autocomplete: "off",
						Placeholder:  "10",
						Value:        form.Repetitions,
						HasError:     formErr.Repetitions != "",
						Class:        "border-none flex-1 p-2",
					})
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Type:    button.TypeButton,
						Class:   "border-l-2 border-outline border-dotted",
						Attributes: templ.Attributes{
							"hx-on:click": `
								const inp = this.previousElementSibling;
								const v = parseInt(inp.value) || 0;
								inp.value = Math.max(1, v - 1);
							`,
						},
					}) {
						-
					}
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Type:    button.TypeButton,
						Class:   "border-l-2 border-outline border-dotted",
						Attributes: templ.Attributes{
							"hx-on:click": `
								const inp = this.previousElementSibling.previousElementSibling;
								const v = parseInt(inp.value) || 0;
								inp.value = v + 1;
							`,
						},
					}) {
						+
					}
				</div>
				if formErr.Repetitions != "" {
					<p role="alert" class="text-error text-sm">{ formErr.Repetitions }</p>
				}
			</label>
		</fieldset>
		if formErr.Root != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Title() {
					something went wrong
				}
				@alert.Description() {
					{ formErr.Root }
				}
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
			save
			@spinner.Spinner()
		}
		@link.Link(link.Props{Href: fmt.Sprintf("/exercises/%d", exerciseID), Class: "ml-auto"}) {
			cancel
		}
	</form>
}
