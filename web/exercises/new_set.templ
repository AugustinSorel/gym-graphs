package exercises

import (
	"fmt"
	"strconv"
	"github.com/augustinsorel/gym-graphs/internal/database/db"
	"github.com/augustinsorel/gym-graphs/internal/weightunit"
	"github.com/augustinsorel/gym-graphs/web/ui/alert"
	"github.com/augustinsorel/gym-graphs/web/ui/button"
	"github.com/augustinsorel/gym-graphs/web/ui/input"
	"github.com/augustinsorel/gym-graphs/web/ui/link"
	"github.com/augustinsorel/gym-graphs/web/ui/spinner"
)

type NewSetRowValues struct {
	Weight      string
	Repetitions string
}

type NewSetRowErr struct {
	Weight      string
	Repetitions string
}

type NewSetFormErr struct {
	Rows []NewSetRowErr
	Root string
}

templ NewSetPage() {
	<main class="flex flex-col py-10 px-5 lg:px-10 gap-10 lg:gap-20 max-w-3xl mx-auto my-10 lg:my-20">
		<h1 class="font-semibold text-3xl">new sets</h1>
		{ children... }
	</main>
}

templ NewSetPageWithForm(exerciseID int32, rows []NewSetRowValues, formErr NewSetFormErr, weightUnit db.WeightUnit) {
	@NewSetPage() {
		@NewSetForm(exerciseID, rows, formErr, weightUnit)
	}
}

templ NewSetForm(exerciseID int32, rows []NewSetRowValues, formErr NewSetFormErr, weightUnit db.WeightUnit) {
	<form
		hx-post={ fmt.Sprintf("/exercises/%d/sets/new", exerciseID) }
		hx-disable="find button[type='submit']"
		hx-indicator="find button[type='submit']"
		hx-swap="outerHTML"
		class="flex flex-col gap-10"
	>
		for i, row := range rows {
			{{ rowErr := NewSetRowErr{} }}
			if i < len(formErr.Rows) {
				{{ rowErr = formErr.Rows[i] }}
			}
			@NewSetRow(i+1, row, rowErr, weightUnit)
		}
		if formErr.Root != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Title() {
					something went wrong
				}
				@alert.Description() {
					{ formErr.Root }
				}
			}
		}
		@link.Link(link.Props{
			Href:  fmt.Sprintf("/exercises/%d/sets/row", exerciseID),
			Class: "ml-auto text-outline mb-10",
			Attributes: templ.Attributes{
				"hx-get":    fmt.Sprintf("/exercises/%d/sets/row", exerciseID),
				"hx-target": "this",
				"hx-swap":   "beforebegin",
			},
		}) {
			add set
		}
		@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
			save
			@spinner.Spinner()
		}
		@link.Link(link.Props{Href: fmt.Sprintf("/exercises/%d", exerciseID), Class: "ml-auto"}) {
			cancel
		}
	</form>
}

templ NewSetRow(index int, form NewSetRowValues, formErr NewSetRowErr, weightUnit db.WeightUnit) {
	{{ weightPlaceholder := "80" }}
	if weightUnit == db.WeightUnitLbs {
		{{ weightPlaceholder = "176" }}
	}
	<fieldset class="space-y-10 mt-10 first:mt-0">
		if index > 0 {
			<legend class="uppercase text-outline border-b-4 border-on-surface text-sm pb-2 w-full">
				set { strconv.Itoa(index) }
			</legend>
		} else {
			<legend class="uppercase text-outline border-b-4 border-on-surface text-sm pb-2 w-full">new set</legend>
			<script>
				(function() {
					const fieldsets = document.querySelectorAll("form fieldset");
					const legend = fieldsets[fieldsets.length - 1].querySelector("legend");
					legend.textContent = "set " + fieldsets.length;
				})();
			</script>
		}
		<label class="grid gap-2 has-[>[aria-invalid=true]]:text-error">
			<span class="text-outline text-sm pb-2">
				weight (<abbr title={ weightunit.Name(weightUnit) } class="no-underline">{ weightunit.Abbr(weightUnit) }</abbr>):
			</span>
			@CounterBtn(input.Props{
				Name:        "weight",
				Placeholder: weightPlaceholder,
				Value:       form.Weight,
				HasError:    formErr.Weight != "",
			})
			if formErr.Weight != "" {
				<p role="alert" class="text-error text-sm">{ formErr.Weight }</p>
			}
		</label>
		<label class="grid gap-2 has-[>[aria-invalid=true]]:text-error">
			<span class="text-outline text-sm pb-2">repetitions:</span>
			@CounterBtn(input.Props{
				Name:        "repetitions",
				Placeholder: "10",
				Value:       form.Repetitions,
				HasError:    formErr.Repetitions != "",
			})
			if formErr.Repetitions != "" {
				<p role="alert" class="text-error text-sm">{ formErr.Repetitions }</p>
			}
		</label>
	</fieldset>
}

templ CounterBtn(props input.Props) {
	{{
		props.Type = input.TypeNumber
		props.Autocomplete = "off"
		props.Class = "border-none flex-1 p-2"
		props.Attributes = templ.Attributes{"step": "any"}
	}}
	<div class="border-y-2 border-dotted border-outline flex items-center">
		@input.Input(props)
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Type:    button.TypeButton,
			Class:   "border-l-2 border-outline border-dotted",
			Attributes: templ.Attributes{
				"aria-label": "increase weight by 1",
				"hx-on:click": `
								const inp = this.previousElementSibling;
								const v = parseFloat(inp.value) || 0;
								inp.value = Math.max(0, parseFloat((v - 1).toFixed(3)));
							`,
			},
		}) {
			-
		}
		@button.Button(button.Props{
			Variant: button.VariantGhost,
			Type:    button.TypeButton,
			Class:   "border-l-2 border-outline border-dotted",
			Attributes: templ.Attributes{
				"aria-label": "decrease weight by 1",
				"hx-on:click": `
								const inp = this.previousElementSibling.previousElementSibling;
								const v = parseFloat(inp.value) || 0;
								inp.value = parseFloat((v + 1).toFixed(3));
							`,
			},
		}) {
			+
		}
	</div>
}
