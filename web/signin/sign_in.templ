package signin

import "github.com/augustinsorel/gym-graphs/web/ui/alert"
import "github.com/augustinsorel/gym-graphs/web/ui/button"
import "github.com/augustinsorel/gym-graphs/web/ui/spinner"
import "github.com/augustinsorel/gym-graphs/web/ui/input"
import "github.com/augustinsorel/gym-graphs/web/ui/link"

templ SignInPage() {
	<main class="grid lg:grid-cols-[1fr_auto_1fr] min-h-dvh">
		@signInHeroSection()
		<hr class="bg-current w-1 h-full hidden lg:block"/>
		<section class="max-w-xl w-full m-auto space-y-15 p-4">
			<h1 class="text-xl lg:text-5xl text-center">welcome back</h1>
			@SignInForm(SignInFormValues{}, SignInFormErr{})
		</section>
	</main>
}

templ signInHeroSection() {
	<section class="bg-surface-container-high hidden lg:grid p-20 grid-rows-[auto_1fr] justify-content-center">
		<header>
			<span class="text-sm uppercase">gym graphs</span>
		</header>
		<ol class="m-auto flex gap-5 flex-col list-none [counter-reset:my-counter] divide-y divide-current [&>li]:pb-5 border-y pt-5 w-full">
			@heroItem("track", "Every session. Every rep. Every weight.")
			@heroItem("measure", "Progress is a number. Know yours.")
			@heroItem("push", "Last week's max is this week's warm-up.")
			@heroItem("grow", "The graph doesn't lie.")
		</ol>
	</section>
}

templ heroItem(title string, body string) {
	<li class="space-y-1 [&>*]:ml-10 relative before:content-[counter(my-counter,decimal-leading-zero)] before:[counter-increment:my-counter] before:absolute before:-left-0 before:top-2 before:text-sm before:text-outline before:leading-none">
		<h2 class="text-4xl font-semibold uppercase">{ title }</h2>
		<p class="text-sm text-outline">{ body }</p>
	</li>
}

type SignInFormValues struct {
	Email    string
	Password string
}

type SignInFormErr struct {
	Email    string
	Password string
	Root     string
}

templ SignInForm(form SignInFormValues, err SignInFormErr) {
	<form
		hx-post="/sign-in"
		hx-disable="find button[type='submit']"
		hx-indicator="find button[type='submit']"
		class="flex flex-col py-10 px-5 lg:px-10 gap-10"
		hx-swap="outerHTML"
	>
		<label class="grid gap-1 has-[>[aria-invalid=true]]:text-error">
			email:
			@input.Input(input.Props{
				Type:         "email",
				Placeholder:  "hello@google.com",
				Name:         "email",
				Autocomplete: "email",
				Value:        form.Email,
				HasError:     err.Email != "",
			})
			if err.Email != "" {
				<p class="text-error text-sm" role="alert">
					{ err.Email }
				</p>
			}
		</label>
		<label class="grid gap-1 has-[>[aria-invalid=true]]:text-error">
			password:
			@input.Input(input.Props{
				Type:         "password",
				Placeholder:  "********",
				Name:         "password",
				Autocomplete: "current-password",
				Value:        form.Password,
				HasError:     err.Password != "",
			})
			if err.Password != "" {
				<p class="text-error text-sm" role="alert">
					{ err.Password }
				</p>
			}
		</label>
		if err.Root != "" {
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Title() {
					sign in failed
				}
				@alert.Description() {
					{ err.Root }
				}
			}
		}
		@button.Button(button.Props{Type: "submit", FullWidth: true}) {
			sign in
			@spinner.Spinner()
		}
		<div class="flex flex-col text-right text-sm lg:flex-row lg:justify-between gap-1">
			@link.Link(link.Props{Href: "/reset-password"}) {
				forgot password?
			}
			<p>
				don't have an account?{ " " }
				@link.Link(link.Props{Href: "/sign-up"}) {
					sign up
				}
			</p>
		</div>
	</form>
}
