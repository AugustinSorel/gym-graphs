import gleam/list
import gleam/result
import gym_graphs/domains/user.{type UserId}
import gym_graphs/repos/sql
import pog.{type Connection}

pub fn create(db: Connection, user_id: UserId) {
  let exercises = exercises()

  let exercise_tags =
    list.flat_map(exercises, fn(exercise) {
      list.map(exercise.tags, fn(tag) { #(exercise.name, tag) })
    })

  let sets =
    list.flat_map(exercises, fn(exercise) {
      list.map(exercise.sets, fn(set) { #(exercise.name, set) })
    })

  use _ <- result.try(sql.create_tags(db, user_id.value, tags()))

  use _ <- result.try(sql.create_exercises(
    db,
    user_id.value,
    list.map(exercises, fn(exercise) { exercise.name }),
  ))

  use _ <- result.try(sql.create_exercise_tags_by_names(
    db,
    user_id.value,
    list.map(exercise_tags, fn(link) { link.0 }),
    list.map(exercise_tags, fn(link) { link.1 }),
  ))

  use _ <- result.try(sql.create_seed_sets(
    db,
    user_id.value,
    list.map(sets, fn(row) { row.0 }),
    list.map(sets, fn(row) { row.1.weight_in_mg }),
    list.map(sets, fn(row) { row.1.repetitions }),
    list.map(sets, fn(row) { row.1.days_ago }),
  ))

  Ok(Nil)
}

type SeedSet {
  SeedSet(weight_in_mg: Int, repetitions: Int, days_ago: Int)
}

type SeedExercise {
  SeedExercise(name: String, tags: List(String), sets: List(SeedSet))
}

